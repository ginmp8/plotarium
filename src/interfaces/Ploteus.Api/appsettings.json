{
  "Ploteus": {
    "Concurrency": 2,
    "QueueCapacity": 4,
    "TimeoutSeconds": 30,
    "Interactive": {
      "TtlMinutes": 15,
      "MaxCharts": 128,
      "FrameAncestors": [
        "'self'"
      ]
    },
    "Browser": {
      "ExecutablePath": "",
      "AssetsDirectory": "assets",
      "LaunchTimeoutMs": 10000,
      "ProtocolTimeoutMs": 15000
    },
    "Sources": {
      "TimeoutSeconds": 8,
      "AllowedOrigins": [],
      "PrivateOrigins": [],
      "Providers": {}
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
