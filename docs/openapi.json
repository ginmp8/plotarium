{
  "openapi": "3.1.0",
  "info": {
    "title": "Plotarium",
    "version": "0.3.0",
    "description": "Anonymous ASP.NET Core static and interactive chart API. Bundled ECharts 6.1, Plotly 4.1, Mermaid 12.1; browser views, expiring links and limited MCP Apps resource. Remote platform clients and origin policies require separate deployment."
  },
  "security": [],
  "paths": {
    "/v1/render": {
      "post": {
        "operationId": "render",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Requested representation, returned as an attachment. JSON is a reusable definition envelope, not Base64. format=html returns HTML that references this backend, not a portable file.",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition"
                }
              },
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "Hosted interactive viewer document"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or ambiguous request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Input, complexity or output limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Rejected definition, policy or engine failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Render queue full",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Browser missing or startup failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "504": {
            "description": "Render deadline exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "capabilities",
        "responses": {
          "200": {
            "description": "Pinned engines, formats, profile and limits"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live",
        "responses": {
          "200": {
            "description": "Process is alive"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Assets verified and executable file present. Not a rendering smoke test."
          },
          "503": {
            "description": "Browser executable file is absent"
          }
        }
      }
    },
    "/v1/charts": {
      "post": {
        "operationId": "createInteractiveChart",
        "description": "Anonymous temporary chart in process RAM. Id is a bearer capability. Default TTL=15min, capacity=128.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractiveChart"
                }
              }
            }
          },
          "400": {
            "description": "Bad JSON"
          },
          "422": {
            "description": "Invalid chart definition"
          },
          "429": {
            "description": "Active chart capacity exceeded"
          }
        }
      }
    },
    "/v1/charts/{id}/definition": {
      "get": {
        "operationId": "getInteractiveChartDefinition",
        "description": "Request, expiry and engine capabilities",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired chart id"
          }
        }
      }
    },
    "/v1/charts/{id}/view": {
      "get": {
        "operationId": "openInteractiveChart",
        "description": "Full HTML viewer referencing this origin",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired chart id"
          }
        }
      }
    },
    "/v1/charts/{id}/embed": {
      "get": {
        "operationId": "embedInteractiveChart",
        "description": "Compact HTML viewer for iframe",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired chart id"
          }
        }
      }
    },
    "/v1/charts/{id}/preview": {
      "get": {
        "operationId": "previewInteractiveChart",
        "description": "Static preview in requested format; format query supports png/svg/jpeg/webp/pdf",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "png",
                "svg",
                "jpeg",
                "webp",
                "pdf"
              ],
              "default": "png"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired chart id"
          }
        }
      }
    },
    "/v1/charts/{id}/share/{channel}": {
      "get": {
        "operationId": "shareInteractiveChart",
        "description": "Channel-specific link/card descriptor; not message sending",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          },
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "teams",
                "whatsapp",
                "chatgpt",
                "web"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired chart id"
          }
        }
      }
    },
    "/v1/interactive/capabilities": {
      "get": {
        "operationId": "interactiveCapabilities",
        "responses": {
          "200": {
            "description": "Per-engine support, channels, limitations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcpJsonRpc",
        "description": "MCP Streamable HTTP JSON-only subset, no SSE/subscriptions; remote hosts require HTTPS and trusted gateway.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC result or error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "Accepted notification"
          },
          "403": {
            "description": "Browser Origin refused"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RenderRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine"
        ],
        "properties": {
          "engine": {
            "type": "string",
            "enum": [
              "echarts",
              "plotly",
              "mermaid"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg",
              "webp",
              "svg",
              "json",
              "pdf",
              "html"
            ],
            "default": "png"
          },
          "width": {
            "type": "integer",
            "minimum": 64,
            "maximum": 4096,
            "default": 800
          },
          "height": {
            "type": "integer",
            "minimum": 64,
            "maximum": 4096,
            "default": 450
          },
          "scale": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 1
          },
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ],
            "default": "light"
          },
          "background": {
            "type": "string",
            "pattern": "^(#[0-9A-Fa-f]{6}|transparent)$",
            "default": "#ffffff"
          },
          "spec": {
            "type": "object"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "engine": {
                  "const": "mermaid"
                }
              }
            },
            "then": {
              "required": [
                "source"
              ],
              "not": {
                "required": [
                  "spec"
                ]
              }
            },
            "else": {
              "required": [
                "spec"
              ],
              "not": {
                "required": [
                  "source"
                ]
              }
            }
          }
        ],
        "description": "Structural envelope only. The implementation additionally enforces engine-specific shape, duplicate keys, complexity, active-content policy, pixel area and output limits. JSON output is not engine-semantic validation. format=html returns hosted HTML, not a standalone self-contained chart."
      },
      "Definition": {
        "type": "object",
        "required": [
          "schemaVersion",
          "normalization",
          "validation",
          "engineVersion",
          "request"
        ],
        "properties": {
          "schemaVersion": {
            "const": "1"
          },
          "normalization": {
            "const": "envelope-only"
          },
          "validation": {
            "const": "structural-only"
          },
          "engineVersion": {
            "type": "string"
          },
          "request": {
            "$ref": "#/components/schemas/RenderRequest"
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "InteractiveChart": {
        "type": "object",
        "description": "Expiring capability-backed chart descriptor",
        "required": [
          "id",
          "expiresAt",
          "engine",
          "viewUrl",
          "embedUrl",
          "previewUrl",
          "definitionUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "engine": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "viewUrl": {
            "type": "string"
          },
          "embedUrl": {
            "type": "string"
          },
          "previewUrl": {
            "type": "string"
          },
          "definitionUrl": {
            "type": "string"
          },
          "capabilities": {
            "type": "object"
          }
        }
      }
    }
  }
}
