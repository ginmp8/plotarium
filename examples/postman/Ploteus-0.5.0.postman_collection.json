    {
      "name": "0.4 - densitymap devolve 422 offline_densitymap",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"engine\": \"plotly\",\n  \"format\": \"png\",\n  \"width\": 700,\n  \"height\": 450,\n  \"spec\": {\n    \"data\": [\n      {\n        \"type\": \"densitymap\",\n        \"lon\": [\n          -46.6,\n          -73.9,\n          116.4\n        ],\n        \"lat\": [\n          -23.5,\n          40.7,\n          39.9\n        ],\n        \"z\": [\n          1,\n          2,\n          3\n        ]\n      }\n    ],\n    \"layout\": {\n      \"map\": {\n        \"style\": \"white-bg\",\n        \"zoom\": 0.6\n      }\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/v1/render",
        "description": "Uma densidade MapLibre requer worker e tiles e nao sera simulada como pontos."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Codificacao\", () => pm.expect(pm.response.json().code).to.eql(\"offline_densitymap\"));"
            ]
          }
        }
      ]
