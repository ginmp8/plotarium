    {
      "name": "0.4 - ECharts GL bar3D (PNG)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"engine\": \"echarts\",\n  \"width\": 800,\n  \"height\": 540,\n  \"format\": \"png\",\n  \"background\": \"#ffffff\",\n  \"spec\": {\n    \"tooltip\": {},\n    \"visualMap\": {\n      \"max\": 12,\n      \"inRange\": {\n        \"color\": [\n          \"#a5c6ec\",\n          \"#154f96\"\n        ]\n      }\n    },\n    \"xAxis3D\": {\n      \"type\": \"category\",\n      \"data\": [\n        \"Q1\",\n        \"Q2\",\n        \"Q3\"\n      ]\n    },\n    \"yAxis3D\": {\n      \"type\": \"category\",\n      \"data\": [\n        \"2024\",\n        \"2025\",\n        \"2026\"\n      ]\n    },\n    \"zAxis3D\": {\n      \"type\": \"value\"\n    },\n    \"grid3D\": {\n      \"boxWidth\": 110,\n      \"boxDepth\": 70,\n      \"viewControl\": {\n        \"alpha\": 25,\n        \"beta\": 25\n      }\n    },\n    \"series\": [\n      {\n        \"type\": \"bar3D\",\n        \"shading\": \"lambert\",\n        \"data\": [\n          [\n            0,\n            0,\n            3\n          ],\n          [\n            1,\n            0,\n            8\n          ],\n          [\n            2,\n            0,\n            4\n          ],\n          [\n            0,\n            1,\n            5\n          ],\n          [\n            1,\n            1,\n            10\n          ],\n          [\n            2,\n            1,\n            7\n          ],\n          [\n            0,\n            2,\n            8\n          ],\n          [\n            1,\n            2,\n            11\n          ],\n          [\n            2,\n            2,\n            9\n          ]\n        ]\n      }\n    ]\n  }\n}",
