    {
      "name": "GET stateless: portable HTML",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/render?c=%7B%22engine%22%3A%22echarts%22%2C%22spec%22%3A%7B%22xAxis%22%3A%7B%22type%22%3A%22category%22%2C%22data%22%3A%5B%22Jan%22%2C%22Feb%22%2C%22Mar%22%5D%7D%2C%22yAxis%22%3A%7B%22type%22%3A%22value%22%7D%2C%22series%22%3A%5B%7B%22type%22%3A%22bar%22%2C%22data%22%3A%5B4%2C9%2C6%5D%7D%5D%7D%7D&format=html",
