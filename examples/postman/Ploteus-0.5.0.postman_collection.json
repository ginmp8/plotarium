    },
    {
      "name": "02 - Criar mapa-mundi ECharts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"engine\": \"echarts\",\n  \"format\": \"png\",\n  \"width\": 1100,\n  \"height\": 660,\n  \"theme\": \"light\",\n  \"spec\": {\n    \"title\": {\n      \"text\": \"Distribuicao global\"\n    },\n    \"tooltip\": {\n      \"trigger\": \"item\"\n    },\n    \"visualMap\": {\n      \"min\": 0,\n      \"max\": 100,\n      \"left\": 15,\n      \"bottom\": 12\n    },\n    \"series\": [\n      {\n        \"type\": \"map\",\n        \"map\": \"world\",\n        \"roam\": true,\n        \"data\": [\n          {\n            \"name\": \"Brazil\",\n            \"value\": 85\n          },\n          {\n            \"name\": \"United States of America\",\n            \"value\": 45\n          },\n          {\n            \"name\": \"India\",\n            \"value\": 66\n          },\n          {\n            \"name\": \"China\",\n            \"value\": 75\n          }\n        ]\n      }\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/v1/charts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const result = pm.response.json();",
              "pm.collectionVariables.set(\"chartId\", result.id);",
              "console.log(\"Abra este viewer:\", result.viewUrl);"
            ]
          }
        }
      ]
    },
