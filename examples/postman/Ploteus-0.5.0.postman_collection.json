{
  "info": {
    "name": "Ploteus 0.5.0 - Stateless GET and existing interactive API",
    "description": "One GET with URL-encoded JSON, Gzip+Base64URL, remote source URL or configured provider. Remote source cases require operator allowlist. Previous 0.4 collection retained for backwards compatibility.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:55731"
    },
    {
      "key": "chartId",
      "value": "00000000000000000000000000000000"
    },
    {
      "key": "remoteBaseUrl",
      "value": "https://charts.example.com"
    }
  ],
  "item": [
    {
      "name": "GET stateless: JSON compact to PNG",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/render?c=%7B%22engine%22%3A%22echarts%22%2C%22spec%22%3A%7B%22xAxis%22%3A%7B%22type%22%3A%22category%22%2C%22data%22%3A%5B%22Jan%22%2C%22Feb%22%2C%22Mar%22%5D%7D%2C%22yAxis%22%3A%7B%22type%22%3A%22value%22%7D%2C%22series%22%3A%5B%7B%22type%22%3A%22bar%22%2C%22data%22%3A%5B4%2C9%2C6%5D%7D%5D%7D%7D&format=png",
        "description": "One request, no chart ID or server persistence."
      }
    },
    {
      "name": "GET stateless: compressed Gzip Base64URL to SVG",
      "request": {
        "method": "GET",
