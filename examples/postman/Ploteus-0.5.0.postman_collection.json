    {
      "name": "GET stateless: reject metadata URL",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/render?sourceUrl=http%3A%2F%2F169.254.169.254%2Flatest%2Fmeta-data%2F",
        "description": "Negative SSRF test: expected HTTP 403."
      }
    },
    {
      "name": "GET stateless: invalid gzip",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/render?c=invalid%21&encoding=gzip-base64url",
        "description": "Negative validation: expected HTTP 400."
      }
    },
    {
      "name": "01 - Capacidades interativas",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/interactive/capabilities",
        "description": ""
