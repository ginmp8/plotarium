    {
      "name": "GET stateless: remote JSON URL",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/render?sourceUrl=https%3A%2F%2Fcharts.example.com%2Fdefinitions%2Fmonthly&format=png",
        "description": "Only works after allowing this exact HTTPS origin on the server. Source returns full render envelope."
      }
