        "body": {
          "mode": "raw",
          "raw": "{\n  \"engine\": \"plotly\",\n  \"width\": 800,\n  \"height\": 540,\n  \"format\": \"png\",\n  \"background\": \"#ffffff\",\n  \"spec\": {\n    \"data\": [\n      {\n        \"type\": \"scattermap\",\n        \"mode\": \"markers+text\",\n        \"lat\": [\n          -23.55,\n          40.71,\n          51.5,\n          35.68\n        ],\n        \"lon\": [\n          -46.63,\n          -74.0,\n          -0.13,\n          139.69\n        ],\n        \"text\": [\n          \"São Paulo\",\n          \"New York\",\n          \"London\",\n          \"Tokyo\"\n        ],\n        \"marker\": {\n          \"size\": 16,\n          \"color\": \"#d6534d\"\n        }\n      }\n    ],\n    \"layout\": {\n      \"map\": {\n        \"center\": {\n          \"lat\": 10,\n          \"lon\": 0\n        },\n        \"zoom\": 0.8\n      },\n      \"margin\": {\n        \"l\": 0,\n        \"r\": 0,\n        \"t\": 0,\n        \"b\": 0\n      }\n    }\n  }\n}",
